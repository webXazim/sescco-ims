DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=development-only-secret-key
PAYROLL_FIELD_ENCRYPTION_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Riyadh
DATABASE_URL=sqlite:///db.sqlite3
DB_SSLMODE=disable
APP_NAME=SESCCO MS
APP_SUBTITLE=Management System
APP_VERSION=dev
SINGLE_COMPANY_MODE=true
# Optional hard pin. Leave blank to use the sole active company.
PRIMARY_COMPANY_SLUG=
