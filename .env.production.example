# Docker Compose isolation and host binding
COMPOSE_PROJECT_NAME=ims
IMS_ENV_FILE=.env.production
IMS_HTTP_PORT=8087
IMS_BACKUP_DIR=./backups
IMS_USE_SHARED_PROXY=0
IMS_PROXY_NETWORK=a2tdev_proxy
IMS_LOG_MAX_SIZE=10m
IMS_LOG_MAX_FILES=5
IMS_APP_UID=10001
IMS_APP_GID=10001

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_ALLOWED_HOSTS=ims.a2tdev.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://ims.a2tdev.com
DJANGO_TIME_ZONE=Asia/Riyadh
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=false
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_LOG_LEVEL=INFO
APP_NAME=Project Inventory
APP_SUBTITLE=Contracting operations
APP_VERSION=1.0.0

# PostgreSQL. Use long unique values; do not reuse another project's credentials.
POSTGRES_DB=ims_inventory
POSTGRES_USER=ims_inventory
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

# Gunicorn defaults are deliberately modest for a VPS hosting other projects.
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info

# Optional SMTP settings. Leave EMAIL_HOST empty when email is not used.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=inventory@a2tdev.com
