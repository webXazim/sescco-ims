# -----------------------------------------------------------------------------
# REQUIRED SECRETS — replace after copying; never commit .env.production
# Generate all three safely with: bash scripts/create-production-env.sh
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
PAYROLL_FIELD_ENCRYPTION_KEY=replace-with-a-44-character-fernet-key
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Must match POSTGRES_PASSWORD; the generator keeps them synchronized.
DB_PASSWORD=replace-with-a-long-random-database-password

# Optional credentials. Leave blank until SMTP or key rotation is configured.
# Previous Django signing keys are comma-separated during an intentional rotation.
DJANGO_SECRET_KEY_FALLBACKS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# -----------------------------------------------------------------------------
# Deployment identity and host integration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ims
IMS_ENV_FILE=.env.production
IMS_PUBLIC_DOMAIN=ims.sescco.com
IMS_HTTP_PORT=8087

# Host Nginx terminates TLS and forwards to the loopback-only IMS gateway.
IMS_USE_SHARED_PROXY=0
# Used only when IMS_USE_SHARED_PROXY=1; it must name an existing Docker network.
IMS_PROXY_NETWORK=a2tdev_proxy

# Confirmed production Docker network: ims_edge = 172.20.0.0/16.
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1,172.20.0.0/16

# -----------------------------------------------------------------------------
# Django application
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ims.sescco.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://ims.sescco.com
DJANGO_TIME_ZONE=Asia/Riyadh
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# Enable only after confirming every current and future subdomain is HTTPS-only.
DJANGO_HSTS_PRELOAD=false
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_LOG_LEVEL=INFO

APP_NAME=Project Inventory
APP_SUBTITLE=Contracting operations
APP_VERSION=1.0.1

# -----------------------------------------------------------------------------
# PostgreSQL
# POSTGRES_* configures the database container. DB_* configures Django directly;
# Compose also enforces this same mapping. DATABASE_URL is intentionally unused.
# -----------------------------------------------------------------------------
POSTGRES_DB=ims_inventory
POSTGRES_USER=ims_inventory
DATABASE_URL=
DB_ENGINE=postgresql
DB_NAME=ims_inventory
DB_USER=ims_inventory
DB_HOST=ims_db
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

# -----------------------------------------------------------------------------
# Backups, container limits, and logging
# -----------------------------------------------------------------------------
IMS_BACKUP_DIR=./backups
IMS_BACKUP_RETENTION_DAYS=30
IMS_LOG_MAX_SIZE=10m
IMS_LOG_MAX_FILES=5
IMS_APP_UID=10001
IMS_APP_GID=10001
IMS_WEB_PIDS_LIMIT=256

# Release tasks are run explicitly by deploy-production.sh. Keep this disabled.
RUN_STARTUP_TASKS=0

# -----------------------------------------------------------------------------
# Gunicorn — modest defaults for a VPS that hosts other services
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Email (optional). With EMAIL_HOST blank, outbound SMTP is not configured.
# EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are kept in the credentials section.
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=inventory@sescco.com

# One-shot recovery overrides are intentionally NOT persisted here. Supply them
# only to the applicable command when authorized:
# IMS_SKIP_DEPLOY_BACKUP=1
# IMS_SKIP_SAFETY_BACKUP=1
# IMS_ALLOW_LEGACY_BACKUP_WITHOUT_KEY_FINGERPRINT=1
# IMS_REHEARSAL_KEEP=1
