{
  "release": "1.0.111",
  "purpose": "Bound Internal Salary Payments, Bank CSV and WPS at 2K employee scale without full-company payment-profile, readiness or batch-row hydration.",
  "shell": {
    "employee_profiles": "deferred-per-employee",
    "readiness_rows": "deferred-server-pages",
    "batch_rows": "deferred-server-pages",
    "batch_headers": "compact"
  },
  "readiness_register": {
    "channels": [
      "bank_csv",
      "wps"
    ],
    "page_sizes": [
      25,
      50,
      100
    ],
    "default_page_size": 50,
    "scan_chunk": 250,
    "search_authority": "server",
    "filter_authority": "server",
    "summary_authority": "server-exact",
    "serialized_profiles": "visible-page-only"
  },
  "payment_batch_rows": {
    "page_sizes": [
      25,
      50,
      100
    ],
    "default_page_size": 50,
    "search_authority": "server",
    "status_filter_authority": "server",
    "summary_authority": "postgresql-exact",
    "rows_in_shell": false
  },
  "mutation_contract": {
    "response": "compact-delta",
    "forbidden_full_context": [
      "profiles",
      "bankReadiness",
      "wpsReadiness",
      "allBatchRows"
    ]
  },
  "employee_wps_filter": {
    "salary_payment_context_forbidden": true,
    "classification_authority": "payment_readiness"
  },
  "browser": {
    "stale_request_abort": true,
    "page_size_preferences": [
      "payroll-ui-bank-readiness-page-size",
      "payroll-ui-wps-page-size",
      "payroll-ui-payment-page-size"
    ]
  }
}
