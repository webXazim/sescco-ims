{
  "release": "1.0.86",
  "purpose": "Final 2,000 Internal / 5,000 Rental Payroll browser certification freeze. Every high-cardinality live Payroll surface, including Rental Worker Adjustments, must remain server-authoritative, request-cancellable and bounded to at most 100 rendered business rows.",
  "benchmark_volume": {
    "internal_employees": 2000,
    "rental_workers": 5000,
    "history_months": 12
  },
  "page_sizes": [
    25,
    50,
    100
  ],
  "max_rendered_business_rows": 100,
  "max_assignment_expanded_rows": 200,
  "max_global_search_results": 30,
  "max_context_payload_bytes": 2500000,
  "max_settle_ms": 10000,
  "certified_surfaces": [
    "internal-employee-directory",
    "internal-attendance",
    "internal-overtime",
    "salary-setup-employee-structures",
    "payroll-runs-register",
    "payroll-runs-review",
    "internal-advances-adjustments",
    "salary-payments-register",
    "bank-readiness",
    "wps-readiness",
    "documents",
    "reports",
    "archive",
    "delete-recovery",
    "management-approval-center",
    "management-audit-trail",
    "rental-workforce-directory",
    "rental-worker-adjustments",
    "rental-project-timesheets",
    "rental-overtime",
    "rental-assignment-activity",
    "rental-current-deployment",
    "rental-supplier-pool",
    "global-search"
  ],
  "interaction_requirements": [
    "server-side-search-filter-pagination",
    "abort-obsolete-search-and-page-requests",
    "ignore-stale-responses",
    "bounded-browser-state",
    "bounded-dom-rendering",
    "exact-server-aggregates",
    "small-mutation-deltas",
    "deferred-heavy-bootstrap-contexts"
  ],
  "runtime_report": "python manage.py payroll_browser_scale_report --require-benchmark-volume --fail-on-limits",
  "live_browser_runner": "python scripts/certify-payroll-browser-scale.py --base-url <release-url> --username <benchmark-user> --password-env IMS_BROWSER_BENCHMARK_PASSWORD",
  "static_gate": "scripts/verify-payroll-final-browser-certification.py",
  "runtime_evidence": "payroll-browser-scale-report.txt",
  "live_browser_evidence": "payroll-browser-certification.json",
  "schema_change": false,
  "payroll_formula_change": false
}
