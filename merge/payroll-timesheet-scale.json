{
  "release": "1.0.115",
  "purpose": "Keep Internal Attendance/Overtime and Rental Project Timesheets responsive at the 2,000/5,000 benchmark scale by bounding roster/month payloads, using project-period server rosters, and returning mutation deltas instead of full monthly snapshots.",
  "internal_endpoint": "/api/internal/attendance/",
  "rental_endpoint": "/api/rental/timesheets/",
  "page_sizes": [
    25,
    50,
    100
  ],
  "search_debounce_ms": 320,
  "guarantees": [
    "bounded-internal-attendance-roster",
    "bounded-internal-overtime-roster",
    "bounded-rental-project-period-roster",
    "server-side-search-and-filters",
    "abort-obsolete-timesheet-requests",
    "ignore-stale-timesheet-responses",
    "small-attendance-cell-mutation-deltas",
    "small-rental-cell-mutation-deltas",
    "no-full-rental-master-scan-in-timesheet-route",
    "bounded-initial-attendance-bootstrap",
    "server-summary-aggregates",
    "current-page-client-csv-explicitly-labeled"
  ]
}
