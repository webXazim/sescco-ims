{
  "version": 1,
  "product": "SESCCO MS",
  "principles": {
    "archive": "Use for real master records that must leave current operations while historical references stay readable.",
    "delete_unused": "Permanent delete is only for mistaken or duplicate masters with no protected history and must remain server-guarded.",
    "workflow": "Operational transactions are closed, cancelled, reversed, released or superseded through their workflow; they are not archived/deleted as masters.",
    "immutable": "Audit, movement and finalized-document evidence is append-only or reversal-based and must never expose ordinary delete/archive actions.",
    "access": "System users and memberships are deactivated/reactivated so audit actor history remains resolvable."
  },
  "models": {
    "accounts.User": {"mode": "access_deactivate_only"},
    "accounts.CompanyMembership": {"mode": "access_deactivate_only"},

    "core.AuditEvent": {"mode": "immutable_ledger"},
