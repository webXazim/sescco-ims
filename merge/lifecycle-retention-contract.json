{
  "version": 3,
  "product": "SESCCO MS",
  "principles": {
    "archive": "Archive is a reversible lifecycle boundary. For parent masters, operational child scope may inherit the archive state without rewriting permanent child/history rows.",
    "delete_unused": "For selected operational masters, Delete means a 30-day reversible soft-delete. Parent masters may cascade the hidden/non-operational state to dependent current scope while preserving all historical rows.",
    "workflow": "Operational transactions are closed, cancelled, reversed, released or superseded through their workflow; they are not archived/deleted as masters.",
    "immutable": "Audit, movement and finalized-document evidence is append-only or reversal-based and must never expose ordinary delete/archive actions.",
    "access": "System users and memberships are deactivated/reactivated so audit actor history remains resolvable.",
    "trash": "Delete recovery is distinct from Archive. Deleted records are hidden from active selectors, recoverable for 30 days, and may retain protected tombstones after expiry when immutable history still references them.",
    "cascade": "Branch/Office, Department, Manpower Supplier and Project are reversible lifecycle parents: Archive/Delete propagate operational visibility to their current dependent scope; restoring the parent restores only that inherited scope because child permanent state is not overwritten."
  },
