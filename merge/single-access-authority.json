{
  "release": "1.0.117",
  "purpose": "Retire all legacy runtime role authority so SESCCO application access is decided only by CompanyMembership + AccessProfile + EffectiveAccess before User Management CRUD is exposed.",
  "authority": {
    "identity_model": "accounts.User",
    "company_boundary": "accounts.CompanyMembership",
    "runtime_profile": "accounts.AccessProfile",
    "runtime_permission_snapshot": "apps.accounts.access_policy.EffectiveAccess",
    "user_role_removed": true,
    "membership_role_runtime_authority": false,
    "membership_role_classification_only": true,
    "missing_profile_fails_closed": true,
    "access_profile_required": true,
    "django_staff_reserved_for_superusers": true
  },
  "compatibility": {
    "workspace_helpers_derive_from_profile_permissions": true,
    "capability_helpers_derive_from_profile_permissions": true,
    "frontend_workspace_edit_and_action_flags_are_server_profile_derived": true,
    "system_profile_provisioning_may_use_membership_role_classification": true,
    "role_matrix_is_display_and_profile-template_metadata_only": true
  },
  "owner_protection": {
    "authority": "active system AccessProfile role-owner",
    "membership_role_is_not_owner_authority": true,
    "user_deactivation_uses_profile_owner_check": true,
    "membership_deactivation_uses_profile_owner_check": true,
    "system_profile_change_uses_profile_owner_check": true
  },
  "migration": {
    "file": "apps/accounts/migrations/0006_single_access_authority.py",
    "requires_existing_profiles": true,
    "backfills_missing_membership_profiles_before_not_null": true,
    "sets_membership_access_profile_not_null": true,
    "removes_user_role": true,
    "removes_non_superuser_django_staff": true,
    "payroll_formula_change": false
  },
  "reconciliation": {
    "command": "python manage.py merge_access_report --fail-on-errors",
    "owner_check_uses_profile": true,
    "non_superuser_staff_is_error": true,
    "missing_profile_is_error": true,
    "profile_company_mismatch_is_error": true,
    "system_profile_permission_drift_is_error": true
  },
  "schema_change": true,
  "payroll_formula_change": false
}
