{
  "release": "1.0.70",
  "purpose": "Freeze the 2,000 Internal / 5,000 Rental browser-scale contract so large Payroll screens remain bounded from PostgreSQL through API payload, browser state and rendered DOM.",
  "benchmark_volume": {
    "internal_employees": 2000,
    "rental_workers": 5000,
    "history_months": 12
  },
  "browser_limits": {
    "directory_page_sizes": [25, 50, 100],
    "timesheet_page_sizes": [25, 50, 100],
    "assignment_page_sizes": [25, 50, 100],
    "bootstrap_internal_employees": 50,
    "bootstrap_rental_workers": 50,
    "global_search_results_per_entity": 5,
    "search_debounce_ms": 320,
    "max_assignment_activity_events_per_100_segments": 200,
    "max_context_payload_bytes": 2500000
  },
  "certified_surfaces": [
    "internal-employee-directory",
    "rental-workforce-directory",
    "internal-attendance",
    "internal-overtime",
    "rental-project-timesheets",
    "rental-overtime",
    "rental-assignment-activity",
    "rental-current-deployment",
    "rental-supplier-pool",
    "global-search"
  ],
  "rapid-interaction_contract": [
    "abort-obsolete-directory-search",
    "abort-obsolete-attendance-search",
    "abort-obsolete-rental-timesheet-search",
    "abort-obsolete-assignment-search",
    "abort-obsolete-global-search",
    "ignore-stale-response",
    "single-authoritative-request-per-surface",
    "bounded-page-rendering",
    "bounded-bootstrap",
    "small-mutation-deltas",
    "server-side-search-filter-pagination",
    "postgresql-indexed-high-cardinality-search"
  ],
  "runtime_report": "python manage.py payroll_browser_scale_report --require-benchmark-volume --fail-on-limits",
  "live_browser_runner": "python scripts/certify-payroll-browser-scale.py --base-url https://ims.sescco.com --username <user> --password-env IMS_BROWSER_BENCHMARK_PASSWORD",
  "runtime_evidence": "payroll-browser-scale-report.txt",
  "live_browser_evidence": "payroll-browser-certification.json"
}
