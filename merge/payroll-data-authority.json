{
  "version": 1,
  "purpose": "Payroll business records remain server-authoritative; browser persistence is limited to UI preferences and selected-view identifiers.",
  "browser_storage_allowlist": [
    "payroll-ui-bank-export-tab",
    "payroll-ui-bank-export-view",
    "payroll-ui-bank-template-id",
    "payroll-ui-branch-sort",
    "payroll-ui-department-sort",
    "payroll-ui-document-period",
    "payroll-ui-document-tab",
    "payroll-ui-internal-period",
    "payroll-ui-internal-timesheet-page-size",
    "payroll-ui-internal-timesheet-period",
    "payroll-ui-management-cost-mode",
    "payroll-ui-management-period",
    "payroll-ui-period",
    "payroll-ui-rental-period",
    "payroll-ui-rental-settlement-project",
    "payroll-ui-rental-settlement-supplier",
    "payroll-ui-rental-timesheet-page-size",
    "payroll-ui-rental-timesheet-period",
    "payroll-ui-rental-timesheet-project",
    "payroll-ui-report-period",
    "payroll-ui-report-type",
    "payroll-ui-selected-document",
    "payroll-ui-selected-internal-payment-batch",
    "payroll-ui-settings-tab",
    "payroll-ui-sidebar",
    "payroll-ui-sidebar-width",
    "payroll-ui-table-sort",
    "payroll-ui-timesheet-workspace",
    "payroll-ui-workspace",
    "payroll-ui-wps-template-id"
  ],
  "authoritative_domains": [
    {
      "id": "internal-attendance",
      "loader": "loadInternalAttendancePeriod",
      "apply": "applyAttendancePayload",
      "scope": "period"
    },
    {
      "id": "internal-payroll",
      "loader": "loadInternalPayrollPeriod",
      "apply": "applyPayrollPayload",
      "scope": "period"
    },
    {
      "id": "salary-payments",
      "loader": "loadSalaryPayments",
      "apply": "applyPaymentPayload",
      "scope": "period"
    },
    {
      "id": "rental-timesheet",
      "loader": "loadRentalTimesheet",
      "apply": "applyRentalTimesheetPayload",
      "scope": "period+project"
    },
    {
      "id": "rental-settlements",
      "loader": "loadRentalSettlementContext",
      "apply": "applyRentalSettlementPayload",
      "scope": "period"
    }
  ]
}
